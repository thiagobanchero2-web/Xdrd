getgenv().XitadoRayCleanup = function()
    state.destroyed  = true
    state.autoShot   = false
    state.silentAim  = false
    state.fovEnabled = false
    getgenv().XitadoRayTargetPart = nil
    getgenv().XitadoRayHitPos     = nil
    for _, conn in ipairs(connections) do pcall(function() conn:Disconnect() end) end
    table.clear(connections)
    if oldNamecall then pcall(function() hookmetamethod(game, "__namecall", oldNamecall) end) end
    if fovCircle   then pcall(function() fovCircle:Remove() end) end
    getgenv().XitadoRayCleanup = nil
end
